# Public runtime configuration only. Never place secrets in VITE_* variables.
VITE_CHATPALEZ_ORIGIN=https://chatpalez.com
VITE_ALLOWED_HOSTS=chatpalez.com

# Native identity/origin. Android must keep com.chatpalez to remain compatible
# with the existing Google Play application.
CAP_APP_ID=com.chatpalez
CAP_APP_NAME=ChatPalez
CAP_SERVER_URL=https://chatpalez.com
