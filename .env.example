# Public runtime configuration only. Never place secrets in VITE_* variables.
VITE_CHATPALEZ_ORIGIN=https://chatpalez.com
VITE_ALLOWED_HOSTS=chatpalez.com
# Public upload base returned by the site's uploads_path setting.
VITE_CHAT_UPLOADS_BASE_URL=https://cloud.chatpalez.com/uploads/
# Public OneSignal App ID. Leave blank to ship without native push while credentials are pending.
VITE_ONESIGNAL_APP_ID=

# Native identity. Android must keep this exact existing Play Store ID.
CAP_APP_ID=chatpalez.app.webview
CAP_APP_NAME=ChatPalez
