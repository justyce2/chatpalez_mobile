# Public runtime configuration only. Never place secrets in VITE_* variables.
VITE_CHATPALEZ_ORIGIN=https://example.com
VITE_ALLOWED_HOSTS=example.com

# Native identifiers used by capacitor.config.ts during native project generation.
# Replace provisional values before store setup.
CAP_APP_ID=com.chatpalez.mobile
CAP_APP_NAME=ChatPalez

# Hosts permitted to remain inside the Capacitor WebView.
# Keep this aligned with VITE_ALLOWED_HOSTS; do not add third-party domains casually.
CAP_ALLOWED_HOSTS=example.com
