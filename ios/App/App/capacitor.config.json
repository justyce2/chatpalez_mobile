{
	"appId": "com.chatpalez",
	"appName": "ChatPalez",
	"webDir": "dist",
	"appendUserAgent": " ChatPalezMobile/1.0",
	"loggingBehavior": "debug",
	"server": {
		"url": "https://chatpalez.com",
		"cleartext": false,
		"errorPath": "error.html"
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#ffffff",
		"initialFocus": true
	},
	"ios": {
		"backgroundColor": "#ffffff",
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"allowsLinkPreview": false,
		"handleApplicationNotifications": false
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"showSpinner": false,
			"backgroundColor": "#FFFFFFFF"
		},
		"StatusBar": {
			"overlaysWebView": false
		}
	},
	"packageClassList": [
		"AppPlugin",
		"AppLauncherPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"CAPNetworkPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"OneSignalCapacitorPlugin"
	]
}
