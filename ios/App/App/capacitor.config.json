{
	"appId": "chatpalez.app.webview",
	"appName": "ChatPalez",
	"webDir": "dist",
	"appendUserAgent": " ChatPalezMobile/1.0",
	"loggingBehavior": "debug",
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#0066B2",
		"initialFocus": true
	},
	"ios": {
		"backgroundColor": "#0066B2",
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"allowsLinkPreview": false,
		"handleApplicationNotifications": false
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"showSpinner": false,
			"backgroundColor": "#0066B2"
		},
		"StatusBar": {
			"overlaysWebView": false
		},
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true,
			"autoBackdropColor": "auto"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"AppLauncherPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"CAPNetworkPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"OneSignalCapacitorPlugin",
		"SecureStorage"
	]
}
